          "refId": "A",
          "expr": "sum(rate(quobyte_client_read_size_bytes_sum{job=\"quobyte\",service_type=\"quobyte-client\",node=~\"$node\"}[$__rate_interval])) / sum(rate(quobyte_client_read_size_bytes_count{job=\"quobyte\",service_type=\"quobyte-client\",node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "read",
          "datasource": {
