        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "iops",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node) (rate(quobyte_client_read_latency_nanos_count{job=\"quobyte\",service_type=\"quobyte-client\",node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{node}} read",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (node) (rate(quobyte_client_write_latency_nanos_count{job=\"quobyte\",service_type=\"quobyte-client\",node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{node}} write",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
