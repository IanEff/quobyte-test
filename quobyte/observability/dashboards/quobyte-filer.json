{
  "title": "Quobyte Filer",
  "uid": "quobyte-filer",
  "tags": [
    "quobyte"
  ],
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Filer-style view of the rig: client read/write IOPS, throughput and latency, metadata ops, device latency, S3 at L7. Local to quobyte-test, not upstream.",
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "node",
        "type": "query",
        "label": "Client node",
        "multi": true,
        "includeAll": true,
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "refresh": 2,
        "query": {
          "query": "label_values(quobyte_client_read_latency_nanos_count{job=\"quobyte\",service_type=\"quobyte-client\"}, node)",
          "refId": "q"
        },
        "definition": "label_values(quobyte_client_read_latency_nanos_count{job=\"quobyte\",service_type=\"quobyte-client\"}, node)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Read IOPS",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "iops",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(quobyte_client_read_latency_nanos_count{job=\"quobyte\",service_type=\"quobyte-client\",node=~\"$node\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Write IOPS",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "iops",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(quobyte_client_write_latency_nanos_count{job=\"quobyte\",service_type=\"quobyte-client\",node=~\"$node\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Read p99",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(quobyte_client_read_latency_nanos_bucket{job=\"quobyte\",service_type=\"quobyte-client\",node=~\"$node\"}[$__rate_interval]))) / 1e9",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Write p99",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(quobyte_client_write_latency_nanos_bucket{job=\"quobyte\",service_type=\"quobyte-client\",node=~\"$node\"}[$__rate_interval]))) / 1e9",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ]
    },
    {
